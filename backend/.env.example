# Postgres
#
# Local dev:
#   DATABASE_URL=postgresql://bankr:bankr@localhost:5432/bankr
#
# Shared Supabase dev instance: use the "Session pooler" connection string
# from Project Settings > Database > Connection string (NOT "Direct
# connection" -- that's IPv6-only and unreachable from most networks; NOT
# "Transaction pooler" on port 6543 -- pgbouncer transaction mode breaks
# SQLAlchemy's prepared statements). Session pooler is IPv4-friendly and
# behaves like a normal Postgres connection:
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://bankr:bankr@localhost:5432/bankr

# Sign in with Apple
APPLE_TEAM_ID=
APPLE_CLIENT_ID=com.yourname.Bankr
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# Backend-issued session JWT
SESSION_JWT_SECRET=change-me-in-prod
SESSION_JWT_ALGORITHM=HS256
SESSION_JWT_TTL_SECONDS=2592000

# Fernet key encrypting aggregator access tokens at rest. Generate one per
# environment with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Plaid (bank aggregator)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_SECRET=

# Agent LLM backend -- see app/agent/agent_client.py. "openrouter" (default)
# uses OPENROUTER_API_KEY/OPENROUTER_MODEL below, routed through
# openrouter.ai. "anthropic" uses ANTHROPIC_API_KEY/ANTHROPIC_MODEL to talk
# to Claude's native Messages API directly. "openai_compatible" uses
# AGENT_API_KEY/AGENT_MODEL/AGENT_BASE_URL instead, for cheap local
# prototyping directly against DeepSeek, Kimi (Moonshot), GPT-5-mini, etc.
AGENT_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Bankr

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

AGENT_API_KEY=
AGENT_MODEL=deepseek-chat
AGENT_BASE_URL=https://api.deepseek.com

# Extended/reasoning thinking before the model answers -- only wired up for
# the "anthropic" and "openrouter" providers above (see providers.py). Off by
# default: it's slower and costs more tokens per reply.
AGENT_EXTENDED_THINKING=false
AGENT_THINKING_BUDGET_TOKENS=2048

# Web search tool (app/agent/tools.py's web_search) -- optional. Get a key at
# https://api.search.brave.com (free tier available). Without one, the tool
# returns a clear error result instead of live results.
BRAVE_SEARCH_API_KEY=

# APNs
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY_PATH=
APNS_TOPIC=com.yourname.Bankr
APNS_USE_SANDBOX=true
