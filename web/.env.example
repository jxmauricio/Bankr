# Backend origin the web app calls. Defaults to http://localhost:8000 when
# unset; set it in Vercel's project env vars to the deployed Render URL.
VITE_API_BASE_URL=

# Browser error reporting (Sentry). Blank disables it. A browser DSN is
# public by design, so it's safe in a Vite env var. See src/lib/monitoring.ts
# for what is (stack traces only) and isn't sent.
VITE_SENTRY_DSN=

# Optional: shown on the /privacy page as the contact for privacy questions.
# Blank tells people to ask whoever invited them.
VITE_CONTACT_EMAIL=
